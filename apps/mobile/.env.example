# Copy to .env.local. Leave everything empty to run in demo mode:
# in-memory seeded data on the device and a deterministic concierge model.

# Supabase (local defaults are printed by `supabase status`).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, read by the /api/concierge route. Never prefix with EXPO_PUBLIC_.
# Vercel AI Gateway key; any gateway model id works for CONCIERGE_MODEL.
AI_GATEWAY_API_KEY=
CONCIERGE_MODEL=openai/gpt-5-mini
