# Copy to .env.local. Leave the Supabase values empty to run in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Signs the demo-mode session cookie. Optional: a random per-process key is used if unset.
DEMO_SESSION_SECRET=

# Timezone that defines "today" on the dashboard.
MARKETPLACE_TIME_ZONE=America/Chicago
